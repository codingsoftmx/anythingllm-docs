# Documentation Site Environment Variables
# Copy this file to .env.local and customize for your project

# ================================================
# SITE CONFIGURATION
# ================================================

# Site name (shown in logo and titles)
NEXT_PUBLIC_SITE_NAME="AnythingLLM Docs"

# Site domain (used for SEO and meta tags)
NEXT_PUBLIC_SITE_DOMAIN="docs.anythingllm.com"

# Site URL (full URL for OG images and social cards)
NEXT_PUBLIC_SITE_URL="https://docs.anythingllm.com"

# Site description (for SEO meta tags)
NEXT_PUBLIC_SITE_DESCRIPTION="All-in-one AI application that can do RAG, AI Agents, and much more with no code or infrastructure headaches."

# ================================================
# BRANDING
# ================================================

# Organization/Company name (for footer copyright)
NEXT_PUBLIC_COMPANY_NAME="Mintplex Labs"

# Company URL (for footer link)
NEXT_PUBLIC_COMPANY_URL="https://github.com/Mintplex-Labs"

# Logo text (shown next to logo icon)
NEXT_PUBLIC_LOGO_TEXT="AnythingLLM Docs"

# ================================================
# SOCIAL & COMMUNITY
# ================================================

# Twitter/X handle (for social card)
NEXT_PUBLIC_TWITTER_HANDLE="@mintplexlabs"

# Twitter/X URL (for top nav icon)
NEXT_PUBLIC_TWITTER_URL="https://twitter.com/mintplexlabs"

# Discord invite URL (for top nav icon)
NEXT_PUBLIC_DISCORD_URL="https://discord.gg/Dh4zSZCdsC"

# GitHub organization URL
NEXT_PUBLIC_GITHUB_URL="https://github.com/Mintplex-Labs"

# Documentation repository (for "Edit this page" link)
NEXT_PUBLIC_DOCS_REPO="https://github.com/Mintplex-Labs/anythingllm-docs/tree/main"

# ================================================
# FEATURES & BANNER
# ================================================

# Enable download banner (true/false)
NEXT_PUBLIC_ENABLE_BANNER="true"

# Banner text (HTML allowed)
NEXT_PUBLIC_BANNER_TEXT="🚀 AnythingLLM is live! Update now →"

# Banner link URL
NEXT_PUBLIC_BANNER_URL="https://anythingllm.com/download"

# Banner storage key (change this to reset banner for users)
NEXT_PUBLIC_BANNER_KEY="release"

# ================================================
# SEO & META
# ================================================

# Default page title template (%s = page title)
NEXT_PUBLIC_TITLE_TEMPLATE="%s ~ AnythingLLM"

# Theme color (for mobile browsers)
NEXT_PUBLIC_THEME_COLOR="#2f3136"

# Favicon path
NEXT_PUBLIC_FAVICON_PATH="/favicon.png"

# OG Image path (default social card)
NEXT_PUBLIC_OG_IMAGE="/images/og.png"

# ================================================
# BUILD & DEPLOYMENT
# ================================================

# Base path (if not deploying to root domain, e.g., "/docs")
NEXT_PUBLIC_BASE_PATH=""

# Output directory (default: 'dist')
NEXT_PUBLIC_OUTPUT_DIR="dist"

# ================================================
# ANALYTICS (Optional)
# ================================================

# Google Analytics ID (optional)
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# ================================================
# REUSE TEMPLATE INSTRUCTIONS:
# ================================================
# 1. Copy this file to .env.local
# 2. Replace all values with your project info
# 3. Update theme.config.tsx reads from process.env
# 4. Update next.config.js if needed
# 5. Deploy with your environment variables
# ================================================
